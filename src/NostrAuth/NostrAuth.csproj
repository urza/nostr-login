<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Log in to ASP.NET Core apps with a Nostr key (NIP-07, NIP-46, NIP-98).</Description>
    <!-- packages.lock.json pins the exact package build, so a restore cannot resolve a different one. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- The only package. secp256k1 with BIP-340 Schnorr is not in .NET, and elliptic-curve code
         is the one piece that should not be hand-written here. ChaCha20 (NIP-44) and the QR code
         encoder are in this project, so there is nothing else to trust. -->
    <PackageReference Include="NBitcoin.Secp256k1" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\**" />
    <InternalsVisibleTo Include="NostrAuth.Tests" />
  </ItemGroup>

</Project>
